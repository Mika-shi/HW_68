@model List<home_work_66.Models.Chat>

@{
    ViewData["Title"] = "Мои отклики";
}

<div class="container py-4">

    <h2 class="fw-bold mb-4">Мои отклики</h2>

    @if (Model.Count == 0)
    {
        <div class="alert alert-light border shadow-sm">
            Вы пока не откликались на вакансии.
        </div>
    }
    else
    {
        @foreach (var response in Model)
        {
            <div class="card shadow-sm border-0 rounded-4 mb-3">
                <div class="card-body p-4">

                    <h5 class="fw-bold mb-2">
                        <a asp-controller="Company" asp-action="Details" asp-route-id="@response.VacancyId" class="text-decoration-none">
                            @response.Vacancy?.Title
                        </a>
                    </h5>

                    <p class="mb-1">
                        <strong>Компания:</strong>
                        @(response.Company?.CompanyName ?? response.Company?.UserName)
                    </p>

                    <p class="mb-3">
                        <strong>Резюме:</strong> @response.Resume?.Title
                    </p>

                    <a asp-controller="Chat" asp-action="Index" asp-route-id="@response.Id" asp-route-companyId="@response.CompanyId" class="btn btn-outline-primary btn-sm">
                        Перейти в чат
                    </a>

                </div>
            </div>
        }
    }

</div>