@model home_work_66.ViewModels.ChatCreateViewModel

<form asp-controller="Chat" asp-action="Create" method="post" id="respondForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="VacancyId" />
    <input type="hidden" asp-for="CompanyId" />

    <div class="modal-body py-4">
        <div class="mb-3">
            <label asp-for="ResumeId" class="form-label fw-semibold">Выберите резюме для отклика:</label>
            
            @if (Model.Resumes != null && Model.Resumes.Any())
            {
                <select asp-for="ResumeId" class="form-select rounded-3 py-2" required>
                    <option value="">-- Выберите ваше резюме --</option>
                    @foreach (var resume in Model.Resumes)
                    {
                        <option value="@resume.Id">@resume.Title (@(resume.Category?.Name ?? "Без категории"))</option>
                    }
                </select>
                <span asp-validation-for="ResumeId" class="text-danger small"></span>
            }
            else
            {
                <div class="alert alert-warning mb-0 small">
                    У вас пока нет созданных резюме. Сначала создайте резюме в личном кабинете, чтобы откликаться на вакансии.
                </div>
            }
        </div>
    </div>

    <div class="modal-footer border-0 pt-0">
        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Отмена</button>
        @if (Model.Resumes != null && Model.Resumes.Any())
        {
            <button type="submit" class="btn btn-primary rounded-pill px-4">Подтвердить отклик</button>
        }
    </div>
</form>