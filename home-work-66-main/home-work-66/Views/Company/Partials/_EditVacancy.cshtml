@model home_work_66.ViewModels.CreateVacancyViewModel

<form id="editVacancyForm" asp-controller="Company" asp-action="EditVacancy" asp-route-id="@Model.Id" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="modal-title mb-0">Редактировать вакансию</h4>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
    </div>

    <div class="mb-3">
        <label asp-for="Title" class="form-label">Название вакансии *</label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CategoryId" class="form-label">Категория *</label>
        <select asp-for="CategoryId" class="form-select">
            <option value="">Выберите категорию</option>
            @if (ViewBag.Categories != null)
            {
                foreach (var category in ViewBag.Categories)
                {
                    <option value="@category.Id">@category.Name</option>
                }
            }
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Salary" class="form-label">Заработная плата *</label>
        <input asp-for="Salary" class="form-control" type="number" />
        <span asp-validation-for="Salary" class="text-danger"></span>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <label asp-for="ExperienceFrom" class="form-label">Опыт работы от (лет)</label>
            <input asp-for="ExperienceFrom" class="form-control" type="number" min="0" />
            <span asp-validation-for="ExperienceFrom" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="ExperienceTo" class="form-label">Опыт работы до (лет)</label>
            <input asp-for="ExperienceTo" class="form-control" type="number" min="0" />
            <span asp-validation-for="ExperienceTo" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">Детальное описание вакансии *</label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Requirements" class="form-label">Требования к соискателю</label>
        <textarea asp-for="Requirements" class="form-control" rows="2"></textarea>
        <span asp-validation-for="Requirements" class="text-danger"></span>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
        <button type="submit" class="btn btn-primary">Сохранить</button>
    </div>
</form>
