@model home_work_66.Models.Course

@{
    ViewData["Title"] = "Добавить курс";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow-sm border-0">
                <div class="card-body">

                    <h2 class="mb-4">Курс</h2>

                    <form asp-controller="Resume" asp-action="AddCourse" method="post">

                        <input type="hidden" asp-for="ResumeId" value="@ViewBag.ResumeId" />

                        <div class="mb-3">
                            <label asp-for="CourseName" class="form-label">Название курса</label>
                            <input asp-for="CourseName" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="OrganizationName" class="form-label">Организация</label>
                            <input asp-for="OrganizationName" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Year" class="form-label">Год прохождения</label>
                            <input asp-for="Year" class="form-control" type="number" />
                            <span asp-validation-for="Year" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Добавить</button>

                            <a asp-controller="Resume" asp-action="Details" asp-route-id="@ViewBag.ResumeId" class="btn btn-secondary">
                                Отмена
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>