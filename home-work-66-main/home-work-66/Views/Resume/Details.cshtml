@model home_work_66.Models.Resume

@{
    ViewData["Title"] = "Резюме";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">@Model.Title</h2>
            <p class="text-muted mb-0"><strong>Категория:</strong> @Model.Category?.Name</p>
        </div>

        <a asp-controller="User" asp-action="Index" class="btn btn-secondary">
            Назад
        </a>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">

            <h4 class="mb-3">Основная информация</h4>

            @if (Model.Salary != null)
            {
                <p><strong>Ожидаемая зарплата:</strong> @Model.Salary</p>
            }

            @if (!string.IsNullOrEmpty(Model.Email))
            {
                <p><strong>Email:</strong> @Model.Email</p>
            }

            @if (!string.IsNullOrEmpty(Model.PhoneNumber))
            {
                <p><strong>Телефон:</strong> @Model.PhoneNumber</p>
            }

            @if (!string.IsNullOrEmpty(Model.Telegram))
            {
                <p><strong>Telegram:</strong> @Model.Telegram</p>
            }

            @if (!string.IsNullOrEmpty(Model.Facebook))
            {
                <p><strong>Facebook:</strong> @Model.Facebook</p>
            }

            @if (!string.IsNullOrEmpty(Model.LinkedIn))
            {
                <p><strong>LinkedIn:</strong> @Model.LinkedIn</p>
            }

        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="mb-0">Опыт работы</h4>

                <a asp-controller="Resume" asp-action="AddWorkExperience" asp-route-resumeId="@Model.Id" class="btn btn-outline-primary btn-sm">
                    Добавить опыт
                </a>
            </div>

            @if (Model.WorkExperiences.Count == 0)
            {
                <p class="text-muted mb-0">Опыт работы не добавлен.</p>
            }
            else
            {
                @foreach (var workExperience in Model.WorkExperiences)
                {
                    <div class="border rounded p-3 mb-3">

                        <h5>@workExperience.CompanyName</h5>

                        <p class="mb-1">
                            <strong>Должность:</strong> @workExperience.Position
                        </p>

                        <p class="mb-1">
                            <strong>Период:</strong> @workExperience.StartYear - @workExperience.EndYear
                        </p>

                        <p class="mb-3">
                            <strong>Обязанности:</strong> @workExperience.Responsibilities
                        </p>

                        <a asp-controller="Resume" asp-action="EditWorkExperience" asp-route-id="@workExperience.Id" class="btn btn-outline-primary btn-sm">
                            Редактировать
                        </a>

                        <form asp-controller="Resume" asp-action="DeleteWorkExperience" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@workExperience.Id" />
                            <button type="submit" class="btn btn-outline-danger btn-sm">Удалить</button>
                        </form>

                    </div>
                }
            }

        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="mb-0">Образование</h4>

                <a asp-controller="Resume" asp-action="AddEducation" asp-route-resumeId="@Model.Id" class="btn btn-outline-primary btn-sm">
                    Добавить образование
                </a>
            </div>

            @if (Model.Educations.Count == 0)
            {
                <p class="text-muted mb-0">Образование не добавлено.</p>
            }
            else
            {
                @foreach (var education in Model.Educations)
                {
                    <div class="border rounded p-3 mb-3">

                        <h5>@education.InstitutionName</h5>

                        <p class="mb-1">
                            <strong>Специальность:</strong> @education.Specialty
                        </p>

                        <p class="mb-0">
                            <strong>Год окончания:</strong> @education.GraduationYear
                        </p>
                        
                        <div class="mt-3">
                            <a asp-controller="Resume" asp-action="EditEducation" asp-route-id="@education.Id" class="btn btn-outline-primary btn-sm">
                                Редактировать
                            </a>

                            <form asp-controller="Resume" asp-action="DeleteEducation" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@education.Id" />
                                <button type="submit" class="btn btn-outline-danger btn-sm">Удалить</button>
                            </form>
                        </div>

                    </div>
                }
            }

        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="mb-0">Курсы</h4>

                <a asp-controller="Resume" asp-action="AddCourse" asp-route-resumeId="@Model.Id" class="btn btn-outline-primary btn-sm">
                    Добавить курс
                </a>
            </div>

            @if (Model.Courses.Count == 0)
            {
                <p class="text-muted mb-0">Курсы не добавлены.</p>
            }
            else
            {
                @foreach (var course in Model.Courses)
                {
                    <div class="border rounded p-3 mb-3">
                        <h5>@course.CourseName</h5>
                        <p class="mb-1">
                            <strong>Организация:</strong> @course.OrganizationName
                        </p>
                        <p class="mb-0">
                            <strong>Год:</strong> @course.Year
                        </p>
                    </div>
                    
                    <div class="mt-3">
                        <a asp-controller="Resume" asp-action="EditCourse" asp-route-id="@course.Id" class="btn btn-outline-primary btn-sm">
                            Редактировать
                        </a>

                        <form asp-controller="Resume" asp-action="DeleteCourse" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@course.Id" />
                            <button type="submit" class="btn btn-outline-danger btn-sm">Удалить</button>
                        </form>
                    </div>
                }
            }

        </div>
    </div>

</div>