@model List<home_work_66.Models.Resume> 

<div class="col-12">
    @if (Model != null && Model.Any())
    {
        foreach (var resume in Model)
        {
            <div class="card shadow-sm border-0 rounded-4 mb-3 w-100 position-relative" style="cursor: pointer;">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="fw-bold text-dark mb-0">
                            <a asp-controller="Resume"
                               asp-action="PublicDetails"
                               asp-route-id="@resume.Id"
                               class="stretched-link text-decoration-none text-dark">
                                @resume.Title
                            </a>
                        </h4>
                        <span class="fs-5 fw-bold text-primary">
                            @resume.Salary?.ToString("N0") сом
                        </span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                        <span class="fw-semibold position-relative" style="z-index: 2;">
                            <i class="bi bi-person-circle me-1 text-secondary"></i>
                            <a asp-controller="User"
                               asp-action="Index"
                               asp-route-id="@resume.UserId"
                               class="text-decoration-none text-primary">
                                @resume.User?.UserName
                            </a>
                        </span>
                        <small class="text-muted">
                            <i class="bi bi-clock-history me-1"></i>
                            Обновлено: @resume.UpdatedAt.ToLocalTime().ToString("dd.MM.yyyy")
                        </small>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-light text-center py-5 border shadow-sm rounded-4">
            <i class="bi bi-file-earmark-text fs-1 text-muted d-block mb-2"></i>
            <h5 class="text-muted mb-0">Опубликованных резюме пока нет.</h5>
        </div>
    }
</div>