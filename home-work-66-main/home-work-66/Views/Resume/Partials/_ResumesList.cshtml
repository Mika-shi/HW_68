@model List<home_work_66.Models.Resume>

@if (Model.Count == 0)
{
    <div class="col-12">
        <div class="card shadow-sm border-0 rounded-4 text-center p-4">
            @if (ViewBag.IsOwner == true)
            {
                <p class="text-muted mb-0">У вас пока нет созданных резюме. Нажмите «Создать резюме», чтобы добавить первое.</p>
            }
            else
            {
                <p class="text-muted mb-0">Пользователь пока не опубликовал резюме.</p>
            }
        </div>
    </div>
}
else
{
    @foreach (var resume in Model)
    {
        <div class="col-12">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <h5 class="fw-bold mb-1">
                                <a asp-controller="Resume" asp-action="@(ViewBag.IsOwner == true ? "Details" : "PublicDetails")" asp-route-id="@resume.Id" class="text-decoration-none text-dark">
                                    @resume.Title
                                </a>
                            </h5>
                            <span class="badge bg-light text-dark border me-2">Категория: @(resume.Category?.Name ?? "—")</span>
                            @if (ViewBag.IsOwner == true)
                            {
                                @if (resume.IsPublished)
                                {
                                    <span class="badge bg-success">Опубликовано</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Не опубликовано</span>
                                }
                            }
                        </div>
                    </div>

                    <p class="text-muted small mb-3">
                        <i class="bi bi-clock me-1"></i>Обновлено: @resume.UpdatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    </p>

                    <div class="d-flex flex-wrap gap-2">
                        <a asp-controller="Resume" asp-action="@(ViewBag.IsOwner == true ? "Details" : "PublicDetails")" asp-route-id="@resume.Id" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-eye me-1"></i> Подробнее
                        </a>

                        @if (ViewBag.IsOwner == true)
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm edit-resume-btn" data-id="@resume.Id" data-bs-toggle="modal" data-bs-target="#exampleModal">
                                <i class="bi bi-pencil me-1"></i> Редактировать
                            </button>

                            <button type="button" class="btn btn-outline-info btn-sm refresh-resume-btn" data-id="@resume.Id" title="Обновить дату резюме">
                                <i class="bi bi-arrow-repeat me-1"></i> Обновить дату
                            </button>

                            <button type="button" class="btn btn-sm @(resume.IsPublished ? "btn-outline-warning" : "btn-outline-success") toggle-publish-btn" data-id="@resume.Id">
                                <i class="bi @(resume.IsPublished ? "bi-eye-slash" : "bi-check2-circle") me-1"></i>
                                @(resume.IsPublished ? "Снять с публикации" : "Опубликовать")
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
}
