@model home_work_66.BLL.Models.User

@{
ViewBag.Title = "Профиль соискателя";
Layout = "_Layout";
}
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-body" id="modal">
            </div>
        </div>
    </div>
</div>


<div class="container py-4">
    <div class="row justify-content-center mb-5">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center">
                        <div class="position-relative me-4">
                            <img src="@Model.AvatarUrl"
                            alt="Аватар пользователя"
                            class="rounded-circle img-thumbnail object-fit-cover shadow-sm"
                            style="width: 100px; height: 100px;"
                            id="userAvatar" />
                            @if (ViewBag.IsOwner == true)
                            {
                                <a asp-controller="User" asp-action="EditProfile" class="btn btn-sm btn-dark rounded-circle position-absolute bottom-0 end-0 shadow-sm d-flex align-items-center justify-content-center"
                                   style="width: 32px; height: 32px;"
                                   data-bs-toggle="modal" data-bs-target="#exampleModal"
                                   title="Редактировать профиль" id="editLink">
                                    <i class="bi bi-pencil-fill text-white" style="font-size: 0.8rem;"></i>
                                </a>
                            }
                        </div>
                        <div>
                            <h3 class="fw-bold mb-1" id="userName">@Model.UserName</h3>
                            <p class="text-muted mb-0">
                                Email: <span id="userEmail">@Model.Email</span>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold mb-0">@(ViewBag.IsOwner == true ? "Мои резюме" : "Резюме")</h4>
                @if (ViewBag.IsOwner == true)
                {
                    <button class="btn btn-primary btn-sm rounded-pill px-3" id="createResumeBtn" data-bs-toggle="modal" data-bs-target="#exampleModal">
                        <i class="bi bi-plus-lg me-1"></i> Создать резюме
                    </button>
                }
            </div>
            <div id="resumesContainer" class="row g-3">
            </div>
        </div>
    </div>
</div>



@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
    $(document).on('click', '#editLink', function (e) {
        e.preventDefault();
        $('#modal').load('@Url.Action("EditProfile", "User")', function () {
            $.validator.unobtrusive.parse('#editProfileModal');
        });
    });

    $(document).on('submit', '#editProfileModal', function (e) {
        e.preventDefault();
        let form = $(this);
        let formData = new FormData(this);
        $.ajax({
            url: form.attr('action'),
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function (result) {
                if (result.success) {
                    $('#userAvatar').attr('src', result.img);
                    $('#userName').text(result.name);
                    $('#userEmail').text(result.email);
                    $('#exampleModal').modal('hide');
                } else {
                    alert(result.message);
                }
            }
        });
    });
    
    function loadResumes() {
        $.get('@Url.Action("GetResumes", "Resume")?userId=@Model.Id', function (data) {
            $('#resumesContainer').html(data);
        });
    }
    $(document).ready(function() {
        loadResumes();
    });
    $(document).on('click', '#createResumeBtn', function (e) {
        e.preventDefault();
        $('#modal').load('@Url.Action("Create", "Resume")', function () {
            $.validator.unobtrusive.parse('#createResumeForm');
        });
    });
    $(document).on('submit', '#createResumeForm', function (e) {
        e.preventDefault();
        let form = $(this);
        $.ajax({
            url: form.attr('action'),
            type: 'POST',
            data: form.serialize(),
            success: function (response) {
                if (response.success) {
                    $('#exampleModal').modal('hide');
                    loadResumes();
                } else {
                    alert(response.message);
                    $.validator.unobtrusive.parse('#createResumeForm');
                }
            }
        });
    });
    
    $(document).on('click', '.edit-resume-btn', function (e) {
        e.preventDefault();
        let resumeId = $(this).data('id');
        $('#modal').load('@Url.Action("Edit", "Resume")?id=' + resumeId, function () {
            $.validator.unobtrusive.parse('#editResumeForm');
        });
    });

    $(document).on('submit', '#editResumeForm', function (e) {
        e.preventDefault();
        let form = $(this);
        $.ajax({
            url: form.attr('action'),
            type: 'POST',
            data: form.serialize(),
            success: function (response) {
                if (response.success) {
                    $('#exampleModal').modal('hide');
                    loadResumes();
                } else {
                    alert(response.message);
                    $.validator.unobtrusive.parse('#editResumeForm');
                }
            }
        });
    });
    
    $(document).on('click', '.refresh-resume-btn', function (e) {
        e.preventDefault();
        let resumeId = $(this).data('id');
        $.post('@Url.Action("UpdateDate", "Resume")', { id: resumeId }, function (res) {
            if (res.success) {
                loadResumes(); 
            }
        });
    });
    
    $(document).on('click', '.toggle-publish-btn', function (e) {
        e.preventDefault();
        let resumeId = $(this).data('id');
        $.post('@Url.Action("TogglePublication", "Resume")', { id: resumeId }, function (res) {
            if (res.success) {
                loadResumes();
            }
        });
    });
</script>
}