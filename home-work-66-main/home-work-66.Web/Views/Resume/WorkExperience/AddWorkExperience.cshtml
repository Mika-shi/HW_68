@model home_work_66.BLL.Models.WorkExperience

@{
    ViewData["Title"] = "Добавить опыт работы";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow-sm border-0">
                <div class="card-body">

                    <h2 class="mb-4">Опыт работы</h2>

                    <form asp-controller="Resume" asp-action="AddWorkExperience" method="post">

                        <input type="hidden" asp-for="ResumeId" value="@ViewBag.ResumeId" />

                        <div class="mb-3">
                            <label asp-for="CompanyName" class="form-label">Название компании</label>
                            <input asp-for="CompanyName" class="form-control" />
                            <span asp-validation-for="CompanyName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Position" class="form-label">Должность</label>
                            <input asp-for="Position" class="form-control" />
                            <span asp-validation-for="Position" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="StartYear" class="form-label">Год начала работы</label>
                            <input asp-for="StartYear" class="form-control" type="number" />
                            <span asp-validation-for="StartYear" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EndYear" class="form-label">Год окончания работы</label>
                            <input asp-for="EndYear" class="form-control" type="number" />
                            <span asp-validation-for="EndYear" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Responsibilities" class="form-label">Обязанности</label>
                            <textarea asp-for="Responsibilities" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Responsibilities" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Добавить</button>

                            <a asp-controller="Resume" asp-action="Details" asp-route-id="@ViewBag.ResumeId" class="btn btn-secondary">
                                Отмена
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}