@model home_work_66.BLL.Models.WorkExperience

@{
    ViewData["Title"] = "Редактировать опыт работы";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow-sm border-0">
                <div class="card-body">

                    <h2 class="mb-4">Редактировать опыт работы</h2>

                    <form asp-controller="Resume" asp-action="EditWorkExperience" method="post">

                        <input asp-for="Id" type="hidden" />
                        <input asp-for="ResumeId" type="hidden" />

                        <div class="mb-3">
                            <label asp-for="CompanyName" class="form-label">Название компании</label>
                            <input asp-for="CompanyName" class="form-control" />
                            <span asp-validation-for="CompanyName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Position" class="form-label">Должность</label>
                            <input asp-for="Position" class="form-control" />
                            <span asp-validation-for="Position" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="StartYear" class="form-label">Год начала</label>
                            <input asp-for="StartYear" class="form-control" type="number" />
                            <span asp-validation-for="StartYear" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EndYear" class="form-label">Год окончания</label>
                            <input asp-for="EndYear" class="form-control" type="number" />
                            <span asp-validation-for="EndYear" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Responsibilities" class="form-label">Обязанности</label>
                            <textarea asp-for="Responsibilities" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Responsibilities" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Сохранить</button>

                            <a asp-controller="Resume" asp-action="Details" asp-route-id="@Model.ResumeId" class="btn btn-secondary">
                                Отмена
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}