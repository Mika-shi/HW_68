@model List<home_work_66.BLL.Models.Vacancy>

@if (Model.Count == 0)
{
    <div class="col-12">
        <div class="card shadow-sm border-0 rounded-4 text-center p-4">
            @if (ViewBag.IsOwner)
            {
                <p class="text-muted mb-0">У вас пока нет созданных вакансий. Нажмите «Создать вакансию», чтобы добавить первую.</p>
            }
            else
            {
                <p class="text-muted mb-0">У компании пока нет активных вакансий.</p>
            }
        </div>
    </div>
}
else
{
    @foreach (var vacancy in Model)
    {
        <div class="col-12">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <h5 class="fw-bold mb-1">
                                <a asp-controller="Company" asp-action="Details" asp-route-id="@vacancy.Id" class="text-decoration-none text-dark">
                                    @vacancy.Title
                                </a>
                            </h5>
                            <span class="badge bg-light text-dark border me-2">Категория: @(vacancy.Category?.Name ?? "—")</span>
                            @if (ViewBag.IsOwner == true)
                            {
                                @if (vacancy.IsPublished)
                                {
                                    <span class="badge bg-success">Опубликовано</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Не опубликовано</span>
                                }
                            }
                        </div>
                        <span class="fw-bold text-primary text-nowrap ms-3">@vacancy.Salary сом</span>
                    </div>

                    <p class="text-muted small mb-3">
                        <i class="bi bi-clock me-1"></i>Обновлено: @vacancy.UpdatedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    </p>

                    <div class="d-flex flex-wrap gap-2">
                        <a asp-controller="Company" asp-action="Details" asp-route-id="@vacancy.Id" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-eye me-1"></i> Подробнее
                        </a>

                        @if (ViewBag.IsOwner == true)
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm edit-vacancy-btn"
                                    data-id="@vacancy.Id" data-bs-toggle="modal" data-bs-target="#exampleModal">
                                <i class="bi bi-pencil me-1"></i> Редактировать
                            </button>

                            <button type="button" class="btn btn-outline-info btn-sm refresh-vacancy-btn"
                                    data-id="@vacancy.Id" title="Обновить дату вакансии">
                                <i class="bi bi-arrow-repeat me-1"></i> Обновить дату
                            </button>

                            <button type="button"
                                    class="btn btn-sm @(vacancy.IsPublished ? "btn-outline-warning" : "btn-outline-success") toggle-publish-btn"
                                    data-id="@vacancy.Id">
                                <i class="bi @(vacancy.IsPublished ? "bi-eye-slash" : "bi-check2-circle") me-1"></i>
                                @(vacancy.IsPublished ? "Снять с публикации" : "Опубликовать")
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
}
